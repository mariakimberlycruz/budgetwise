# Copy this file to .env and adjust values as needed.
# cp .env.example .env

APP_NAME=BudgetWise API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Local SQLite database (file is created automatically on first run).
DATABASE_URL=sqlite:///./budgetwise.db

# Comma-separated list of allowed CORS origins, or * for all.
# Default Expo web ports: http://localhost:8081, http://localhost:19006
CORS_ORIGINS=*

API_V1_PREFIX=/api/v1

# Authentication
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
