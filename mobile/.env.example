# BudgetWise mobile configuration
#
# EXPO_PUBLIC_API_URL: full base URL of the FastAPI backend.
# Leave empty to auto-detect (recommended for emulators / Expo Go):
#   - Android emulator  -> http://10.0.2.2:8000
#   - iOS simulator     -> http://localhost:8000
#   - Web               -> http://localhost:8000
#   - Physical device   -> http://<YOUR_LAN_IP>:8000 (auto-derived from Expo host)
#
# If auto-detection does not work for a physical device, set the URL explicitly:
#EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Optional: override the backend port used during auto-detection.
EXPO_PUBLIC_API_PORT=8000
